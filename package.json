{
  "name": "cucumber-town",
  "version": "1.0.0",
  "description": "A Brookhaven-style 3D multiplayer town you play in the browser",
  "scripts": {
    "build": "esbuild src/game.js --bundle --minify --format=iife --outfile=bundle.js && node -e \"const f=require('fs');f.writeFileSync('index.html',f.readFileSync('src/index.template.html','utf8').replace('/*__BUNDLE__*/',()=>f.readFileSync('bundle.js','utf8')))\""
  },
  "dependencies": {
    "three": "^0.185.1",
    "trystero": "^0.25.3",
    "@trystero-p2p/mqtt": "^0.25.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}